            },
            "url": { "raw": "{{baseUrl}}/documents", "host": ["{{baseUrl}}"], "path": ["documents"] },
            "description": "documentType: MEMBERSHIP_DOCUMENT, ASSISTANCE_DOCUMENT, SUPPORT_TICKET_ATTACHMENT, CERTIFICATE, APPOINTMENT_LETTER, OTHER\nrelatedEntityType: MEMBERSHIP, ASSISTANCE_REQUEST, SUPPORT_TICKET, RECEIPT_ENTRY, OTHER"
          }
