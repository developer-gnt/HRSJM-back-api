  "item": [
    {
      "name": "0 - Health",
      "item": [
        {
          "name": "Health Check (PUBLIC)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "No auth needed. Returns server status, timestamp, uptime."
          }
        }
      ]
    },
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Register (PUBLIC)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"New Test User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Str0ngP@ss1\",\n  \"role\": \"MEMBER\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Register a new user.\n\nFields:\n• fullName (required, 2-150 chars)\n• email (required, valid email)\n• password (required, 8-72 chars, must have uppercase + lowercase + digit)\n• role (optional): MEMBER (default), DONOR, DONATION_SEEKER"
          }
        },
        {
          "name": "Login ADMIN ⚡ auto-saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('userId', res.data.user.id);",
                  "  pm.test('Admin token saved!', function() { pm.expect(res.data.accessToken).to.be.a('string'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@hrsjm.org\",\n  \"password\": \"Admin@12345\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login as ADMIN. Token is auto-saved to {{adminToken}}."
          }
        },
        {
          "name": "Login MEMBER ⚡ auto-saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('memberToken', res.data.accessToken);",
                  "  pm.test('Member token saved!', function() { pm.expect(res.data.accessToken).to.be.a('string'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"aisha@example.com\",\n  \"password\": \"Str0ngP@ss\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login as MEMBER. Token is auto-saved to {{memberToken}}."
          }
        },
        {
          "name": "Login DONOR ⚡ auto-saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
