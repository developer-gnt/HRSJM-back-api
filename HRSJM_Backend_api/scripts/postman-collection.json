    {
      "name": "9 Receipts (Credit Entry)",
      "item": [
        {
          "name": "Record income receipt (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"receiptDate\": \"2026-09-28\",\n  \"receivedFrom\": \"Abdul Karim\",\n  \"incomeAccount\": \"Membership Fees\",\n  \"receivedInAccount\": \"Cash Box\",\n  \"amount\": 5000,\n  \"method\": \"CASH\",\n  \"remarks\": \"Monthly membership fee\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/receipts", "host": ["{{baseUrl}}"], "path": ["admin", "receipts"] }
          }
        },
        {
          "name": "List receipts (filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/receipts?page=1&limit=10&fromDate=2026-09-01&toDate=2026-09-30", "host": ["{{baseUrl}}"], "path": ["admin", "receipts"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "fromDate", "value": "2026-09-01" }, { "key": "toDate", "value": "2026-09-30" }] }
          }
        },
        {
          "name": "Get receipt",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/receipts/{{receiptId}}", "host": ["{{baseUrl}}"], "path": ["admin", "receipts", "{{receiptId}}"] }
          }
        },
        {
          "name": "Attach file to receipt (multipart)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "documentName", "value": "Cash slip", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/admin/receipts/{{receiptId}}/attachment", "host": ["{{baseUrl}}"], "path": ["admin", "receipts", "{{receiptId}}", "attachment"] }
          }
        }
      ]
    },
