{
  "info": {
    "name": "HRSJM Backend API (Auto-Token)",
    "description": "HRSJM NGO Backend API - All 13 Modules, 50+ Endpoints.\n\nStep 1: Run 'node scripts/seed.js' to create test accounts\nStep 2: Import this collection into Postman\nStep 3: Hit any Login request → token is auto-saved!\n\nTest Accounts:\n• admin@hrsjm.org / Admin@12345 (ADMIN)\n• aisha@example.com / Str0ngP@ss (MEMBER)\n• rahim@example.com / D0norP@ss (DONOR)\n• nasreen@example.com / S33kerP@ss (DONATION_SEEKER)\n\nSwagger Docs: http://localhost:3000/docs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "memberToken", "value": "" },
    { "key": "donorToken", "value": "" },
    { "key": "seekerToken", "value": "" },
    { "key": "userId", "value": "paste-user-uuid" },
    { "key": "membershipNumber", "value": "HRSJM-2026-00001" },
    { "key": "membershipId", "value": "paste-membership-uuid" },
    { "key": "renewalId", "value": "paste-renewal-uuid" },
    { "key": "documentId", "value": "paste-document-uuid" },
    { "key": "requestId", "value": "paste-request-uuid" },
    { "key": "ticketId", "value": "paste-ticket-uuid" },
    { "key": "notificationId", "value": "paste-notification-uuid" },
    { "key": "recipientId", "value": "paste-recipient-uuid" },
    { "key": "receiptId", "value": "paste-receipt-uuid" },
    { "key": "donationId", "value": "paste-donation-uuid" }
