            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rahim@example.com\",\n  \"password\": \"D0norP@ss\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login as DONOR. Token is auto-saved to {{donorToken}}."
          }
        },
        {
          "name": "Login DONATION_SEEKER ⚡ auto-saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('seekerToken', res.data.accessToken);",
