        {
          "name": "My Renewals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": { "raw": "{{baseUrl}}/renewals/me?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["renewals", "me"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
