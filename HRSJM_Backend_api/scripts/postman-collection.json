            "body": { "mode": "raw", "raw": "{\n  \"membershipId\": \"{{membershipId}}\",\n  \"periodYears\": 1,\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"transactionId\": \"TRX-1001\",\n  \"note\": \"Renewing for one more year\"\n}" },
