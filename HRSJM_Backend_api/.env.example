# Application
APP_NAME=HRSJM
APP_ENV=development
APP_PORT=3000
API_PREFIX=api/v1
CORS_ENABLED=true

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hrsjm
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_LOGGING=false
DATABASE_SSL=false

# Authentication
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_URL=
STORAGE_BUCKET=

# Payment gateway (final provider TBC)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Documents
DOCUMENT_MAX_SIZE_MB=5

# Membership renewal policy (defaults only - pending HRSJM confirmation)
RENEWAL_FEE_PER_YEAR=500.00
RENEWAL_ALLOWED_PERIODS=1,2,5

# Scheduled-send ticker interval (ms) - default 30000 in production
NOTIFICATION_SCHEDULE_TICK_MS=30000
