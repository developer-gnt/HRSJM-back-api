# ==============================================================================
# HRSJM Digital Membership & Donation Platform — Environment Configuration
# ==============================================================================
# SAFE TEMPLATE ONLY. DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.

# Application Configuration
APP_NAME=HRSJM
APP_ENV=development
APP_PORT=3000
API_PREFIX=api/v1
CORS_ENABLED=true
# Comma-separated list of allowed origins (e.g., https://app.hrsjm.org,https://hrsjm.org)
# In development, localhost origins are allowed by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:8089

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hrsjm
DATABASE_USER=hrsjm_dev
DATABASE_PASSWORD=
DATABASE_LOGGING=false
DATABASE_SSL=false
# In production with SSL, set DATABASE_SSL_REJECT_UNAUTHORIZED=true (default) and provide CA bundle:
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT=
# DATABASE_CA_PATH=

# Authentication Configuration
# Required in production: must be a high-entropy string of at least 32 characters
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Swagger / OpenAPI Documentation
# Automatically enabled in development; disabled in production unless SWAGGER_ENABLED=true
SWAGGER_ENABLED=false

# Document Storage Configuration
# Supported drivers: local (development default) | s3 (cloud storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Cloud storage placeholders (when STORAGE_DRIVER=s3)
STORAGE_BUCKET=
STORAGE_URL=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Password Reset / Notification Delivery
# Supported providers: log (development default) | smtp | webhook
EMAIL_PROVIDER=log
# EMAIL_FROM=noreply@hrsjm.org
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Error Monitoring (Sentry)
# SENTRY_DSN=

# Cashfree Payment Gateway Configuration
# Environment: SANDBOX | PRODUCTION
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=TEST_MOCK_APP_ID
CASHFREE_SECRET_KEY=TEST_MOCK_SECRET_KEY
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=hrsjm_cashfree_sandbox_webhook_secret
CASHFREE_RETURN_URL=https://hrsjm.org/payments/callback?order_id={order_id}
CASHFREE_WEBHOOK_URL=http://localhost:3000/api/v1/payments/cashfree/webhook
CASHFREE_API_TIMEOUT_MS=10000
