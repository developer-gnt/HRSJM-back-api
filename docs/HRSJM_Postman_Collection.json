            "url": { "raw": "{{baseUrl}}/memberships/:id/reject", "host": ["{{baseUrl}}"], "path": ["memberships", ":id", "reject"] }
          }
        },
        {
          "name": "Update Membership Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
